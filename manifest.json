{
  "manifest_version": 3,
  "name": "Stack Question Images",
  "description": "Downloads the question images on the page, stacks them vertically, and copies the sheet to the clipboard.",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://onlinecourses.nptel.ac.in/*",
    "https://storage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Stack question images"
  }
}
