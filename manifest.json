{
  "manifest_version": 3,
  "name": "NPTEL Ease",
  "description": "Copies NPTEL questions and weekly lecture transcripts, fills answer choices, and hands prompts off to ChatGPT.",
  "version": "2.3",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://onlinecourses.nptel.ac.in/*",
    "https://storage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://www.youtube.com/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Open NPTEL Ease",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  }
}
